# Technitium DNS/DHCP Server Settings
# You can specify TECHNITIUM_IP and TECHNITIUM_PORT, or full TECHNITIUM_URL
TECHNITIUM_IP=192.168.1.10
TECHNITIUM_PORT=5380
TECHNITIUM_URL=http://192.168.1.10:5380
TECHNITIUM_API_KEY=your_technitium_api_token_here
TECHNITIUM_TIMEOUT=10.0

# Sophos Firewall Settings
# Supported aliases: SOPHOS_IP or SOPHOS_FIREWALL_IP, SOPHOS_LOGIN or SOPHOS_USER, SOPHOS_PASSWORD or SOPHOS_PASS
SOPHOS_IP=192.168.1.1
SOPHOS_PORT=4444
SOPHOS_LOGIN=admin
SOPHOS_PASSWORD=your_sophos_admin_password_here
SOPHOS_CLIENTLESS_GROUP=Clientless Open Group
SOPHOS_VERIFY_SSL=false
SOPHOS_TIMEOUT=15.0

# Sync Options
STATIC_LEASES_ONLY=false
SYNC_INTERVAL=0
DRY_RUN=false
LOG_LEVEL=INFO
